# Your domain. Its DNS record must point to this machine.
SQUADRA_DOMAIN=squadra.example.com

# Ports Caddy publishes (defaults 80 and 443; Let's Encrypt needs them reachable).
# HTTP_PORT=80
# HTTPS_PORT=443
# (Another HTTPS port: the address machines use must include it — set
# PUBLIC_URL=https://your-domain:PORT for the squadra service in docker-compose.yml.)
